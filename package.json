{
  "name": "fashion-doniya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:full": "bun run scripts/dev.ts",
    "dev:api": "bun --hot server.ts",
    "dev:web": "bunx vite --config frontend/vite.config.ts frontend",
    "build": "bunx vite build --config frontend/vite.config.ts frontend",
    "preview": "bunx wrangler pages dev frontend/dist --port 8788",
    "preview:cf": "bunx wrangler pages dev frontend/dist --env preview --port 8788",
    "deploy": "bun run build && bunx wrangler pages deploy frontend/dist",
    "lint": "bunx tsc -b tsconfig.json --noEmit",
    "clean": "bun -e \"const fs=require('fs'); ['frontend/dist','dist','server.js'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "db:generate": "bunx drizzle-kit generate --config=backend/drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config=backend/drizzle.config.ts",
    "db:push": "bunx drizzle-kit push --config=backend/drizzle.config.ts",
    "db:seed": "bun run scripts/seed.ts",
    "d1:migrate:local": "bun run scripts/d1-migrate.ts local",
    "d1:migrate:remote": "bun run scripts/d1-migrate.ts production",
    "d1:migrate:preview": "bun run scripts/d1-migrate.ts preview",
    "r2:upload": "bun run scripts/r2-sync.ts",
    "crawl": "bun run scripts/daily_auto_crawl.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.16.0",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.5.2",
    "react-router": "^7.14.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250401.0",
    "@types/bun": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "wrangler": "^4.0.0"
  }
}
