DEMO_MODE=false
SITE_URL=http://localhost:6900
ALLOWED_ORIGINS=http://localhost:6900,http://localhost:6901,http://127.0.0.1:6900,http://127.0.0.1:6901

# AI Outfit Studio (Gemini)
GEMINI_API_KEY=

# Media Fallback (ImgBB when R2 is unbound)
