PORT=9998
VITE_API_URL=http://127.0.0.1:9998

# Local SQLite or Turso libSQL fallback
TURSO_URL=file:backend/dev.db
TURSO_AUTH_TOKEN=

# Security & Auth (use strong 32+ byte random strings in production)
JWT_SECRET=dev-fashion-doniya-jwt-secret-change-in-production-64chars
ADMIN_API_KEY=dev-fashion-doniya-admin-api-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@fashiondoniyabd.com
ADMIN_PASSWORD=Admin@2026
SYSADM_SECRET=dev-fashion-doniya-sysadm-secret-change-in-production

# Origin & Runtime
NODE_ENV=development
DEMO_MODE=false
SITE_URL=http://localhost:9999
ALLOWED_ORIGINS=http://localhost:9999,http://localhost:9998,http://127.0.0.1:9999,http://127.0.0.1:9998

# AI Outfit Studio (Gemini)
GEMINI_API_KEY=

# Media Fallback (ImgBB when R2 is unbound)
IMGBB_API_KEY=

# Centralized Email Infrastructure (OrbitMail)
ORBITMAIL_API_KEY=
ORBITMAIL_URL=https://mail.orbitsaas.cloud/api/v1/send
ORBITMAIL_FROM=contact@orbitsaas.cloud

# Email Pipeline (OrbitMail -> SendPulse -> Resend -> Amazon SES -> Google Apps Script)
EMAIL_FROM=contact@orbitsaas.cloud
EMAIL_FROM_NAME=Fashion Doniya BD
EMAIL_PROVIDER_ORDER=orbitmail,sendpulse,resend,ses,google_script

# SendPulse accepts either SENDPULSE_API_USER_ID/SECRET or SENDPULSE_CLIENT_ID/SECRET
SENDPULSE_API_USER_ID=
SENDPULSE_API_SECRET=
SENDPULSE_API_KEY=
SENDPULSE_API_URL=https://api.sendpulse.com
SENDPULSE_FROM_EMAIL=contact@orbitsaas.cloud
SENDPULSE_FROM_NAME=Fashion Doniya BD

RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@orbitsaas.cloud
RESEND_FROM_NAME=Fashion Doniya BD

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=contact@orbitsaas.cloud
SES_FROM_NAME=Fashion Doniya BD
SES_CONFIGURATION_SET=

GOOGLE_SCRIPT_URL=
EMAIL_WEBHOOK_SECRET=

# SEO / IndexNow
INDEXNOW_KEY=fashion-doniya-indexnow-key-2026

# Courier Webhook Secret
COURIER_WEBHOOK_SECRET=fd-courier-webhook-2026

# SMS Gateways (GreenWeb BD or BulkSMSBD)
# Policy: Disconnected by default to prevent expensive SMS carrier bills.
# Code is preserved intact. To connect in the future, set SMS_ENABLED=true.
SMS_ENABLED=false
SMS_ALWAYS_SEND=false
GREENWEB_API_TOKEN=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
SMS_SENDER_ID=FashionDoniya

